// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Mux8Way16(
        a=outT, b=incOut, c=in, d=in, 
        e=false, f=false, g=false, h=false, 
        sel[2]=reset, sel[1]=load, sel[0]=inc, out=rIn
    );
    Or(a=inc, b=reset, out=load2);
    Or(a=load, b=load2, out=lR);
    Register(in=rIn, load=lR, out=outT, out=out);
    Inc16(in=outT, out=incOut);
}