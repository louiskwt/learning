// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    Not(in=sel[1], out=notselab);
    DMux(in=true, sel=sel[0], a=sela, b=selb);
    And(a=sel[1], b=selb, out=seld);
    Mux16(a=b , b=a, sel=sela, out=muxab);
    Mux16(a=c, b=d, sel=seld, out=muxcd);
    Mux16(a=muxcd, b=muxab, sel=notselab, out=out);
}