// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    Not(in=sel[2], out=notSel2);
    DMux4Way(in=in, sel=sel[0..1], a=ma, b=mb, c=mc, d=md);
    DMux4Way(in=in, sel=sel[0..1], a=me, b=mf, c=mg, d=mh);
    And(a=notSel2, b=ma, out=a); 
    And(a=notSel2, b=mb, out=b); 
    And(a=notSel2, b=mc, out=c); 
    And(a=notSel2, b=md, out=d); 
    And(a=sel[2], b=me, out=e); 
    And(a=sel[2], b=mf, out=f); 
    And(a=sel[2], b=mg, out=g); 
    And(a=sel[2], b=mh, out=h); 
}