// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    Not(in=sel[0], out=notsel0);
    Not(in=sel[1], out=notsel1);
    Not(in=sel[2], out=notsel2);
    And(a=notsel1, b=notsel2, out=notsel12);
    And(a=notsel0, b=notsel2, out=notsel02);
    And(a=notsel0, b=notsel1, out=notsel01);
    And(a=sel[0], b=sel[1], out=sel11);
    // a
    And(a=notsel0, b=notsel12, out=sela);
    And(a=in, b=sela, out=a);
    // b
    And(a=sel[0], b=notsel12, out=selb);
    And(a=in, b=selb, out=b);
    // c
    And(a=sel[1], b=notsel02, out=selc);
    And(a=in, b=selc, out=c);
    // d
    And(a=sel11, b=notsel2, out=seld);
    And(a=in, b=seld, out=d);
    // e
    And(a=sel[2], b=notsel01, out=sele);
    And(a=in, b=sele, out=e);
    // f
    And(a=sel[0], b=notsel1, out=sel01);
    And(a=sel01, b=sel[2], out=self);
    And(a=in, b=self, out=f);
    // g
    And(a=sel[1], b=notsel0, out=sel10);
    And(a=sel10, b=sel[2], out=selg);
    And(a=in, b=selg, out=g);
    //h
    And(a=sel11, b=sel[2], out=selh);
    And(a=in, b=selh, out=h); 
}