// File name: projects/1/Or.hdl
/**
 * Or gate:
 * if (a or b) out = 1, else out = 0 
 */
CHIP Or {
    IN a, b;
    OUT out;

    PARTS:
    Not(in=a , out=nota2nand );
    Not(in=b , out=notb2nand );
    Nand(a=nota2nand , b=notb2nand , out=out);
}