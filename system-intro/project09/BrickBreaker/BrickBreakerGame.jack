class BrickBreakerGame {
    static BrickBreakerGame instance;
    field Paddle paddle;
    field Ball ball;
    field Array bricks;
    field int brickCount, bricksLeft;
    field int score;
    field int health;
    field int wall;
    field int lastWall;
    field boolean exit;
    field boolean launched;
    field boolean lastHitPaddle;
    field Brick lastHitBrick;

    constructor BrickBreakerGame new() {
        do Screen.clearScreen();
        let paddle = Paddle.new(230, 210, 50, 7);
        let ball = Ball.new(253, 204, 0, 511, 0, 238);
        do createBricks();
        do Screen.drawRectangle(0, 238, 511, 240);
        do Output.moveCursor(22, 0);
        do Output.printString("Score: 0");
        do Output.moveCursor(22, 20);
        do Output.printString("Lives: 3");
        let exit = false;
        let score = 0;
        let wall = 0;
        let health = 3;
        let lastWall = 0;
        let launched = false;
        let lastHitPaddle = false;
        let lastHitBrick = null;
        return this;
    }

    method void dispose() {
        var int i;
        var Brick b;
        do paddle.dispose();
        do ball.dispose();
        let i = 0;
        while (i < brickCount) {
            let b = bricks[i];
            do b.dispose();
            let i = i + 1;
        }
        do bricks.dispose();
        do Memory.deAlloc(this);
        return;
    }

    function void newInstance() {
        let instance = BrickBreakerGame.new();
        return;
    }

    function BrickBreakerGame getInstance() {
        return instance;
    }

    method void createBricks() {
        var int i, col, row, x, y, hits;
        let brickCount = 24;
        let bricksLeft = 24;
        let bricks = Array.new(24);
        let i = 0;
        let row = 0;
        while (row < 3) {
            let hits = 3 - row;
            let col = 0;
            while (col < 8) {
                let x = 28 + (col * 58);
                let y = 12 + (row * 18);
                let bricks[i] = Brick.new(x, y, 50, 10, hits);
                let i = i + 1;
                let col = col + 1;
            }
            let row = row + 1;
        }
        return;
    }

    method void stickBall() {
        var int ballX;
        let ballX = ((paddle.getLeft() + paddle.getRight()) / 2) - 3;
        do ball.setPosition(ballX, paddle.getTop() - 6);
        return;
    }

    method void launch() {
        if (~launched) {
            let launched = true;
            let lastWall = 0;
            do ball.setDestination(ball.getLeft() + 147, 0);
        }
        return;
    }

    method void run() {
        var char key;
        let key = 0;
        while (~exit) {
            while ((key = 0) & (~exit)) {
                let key = Keyboard.keyPressed();
                do paddle.move();
                if (launched) {
                    do moveBall();
                } else {
                    do stickBall();
                }
                do Sys.wait(50);
            }
            if (key = 130) {
                do paddle.setDirection(1);
            } else {
                if (key = 132) {
                    do paddle.setDirection(2);
                } else {
                    if ((key = 131) | (key = 32)) {
                        do launch();
                    } else {
                        if ((key = 140) | (key = 81)) {
                            let exit = true;
                        }
                    }
                }
            }
            while ((~(key = 0)) & (~exit)) {
                let key = Keyboard.keyPressed();
                do paddle.move();
                if (launched) {
                    do moveBall();
                } else {
                    do stickBall();
                }
                do Sys.wait(50);
            }
            do paddle.setDirection(0);
        }
        do Output.moveCursor(10, 20);
        if (bricksLeft = 0) {
            do Output.printString("You Win");
        } else {
            do Output.printString("Game Over");
        }
        return;
    }

    method void moveBall() {
        var int bouncingDirection, paddleLeft, paddleRight, ballLeft, ballRight, i;
        var int overlapX, overlapY, bx, by;
        var Brick b;
        var boolean hitBrick, bounceSide, bounceTop, hasHit;
        var int currentWall;

        let currentWall = ball.move();
        let hitBrick = false;
        let i = 0;

        while ((i < brickCount) & (~hitBrick)) {
            let b = bricks[i];
            if (b.collides(ball.getLeft(), ball.getRight(), ball.getTop(), ball.getBottom())) {
                let hitBrick = true;
                let lastWall = 0; // clear wall memory
                let ballLeft = ball.getLeft();
                let ballRight = ball.getRight();
                let bx = ballLeft;
                let by = ball.getTop();
                let overlapX = Math.min(ballRight, b.getRight()) - Math.max(ballLeft, b.getLeft());
                let overlapY = Math.min(ball.getBottom(), b.getBottom()) - Math.max(ball.getTop(), b.getTop());
                let bounceSide = false;
                let bounceTop = false;

                if (Math.abs(overlapX - overlapY) < 2) {
                    let bounceSide = true;
                    let bounceTop = true;
                } else {
                    if (overlapX < overlapY) {
                        let bounceSide = true;
                    } else {
                        let bounceTop = true;
                    }
                }

                if (~(b = lastHitBrick)) {
                    let lastHitBrick = b;
                    do removeBrick(b);
                }

                if (bounceSide) {
                    if ((ballRight - b.getLeft()) < (b.getRight() - ballLeft)) {
                        let bx = b.getLeft() - 6;
                        if (ball.movingRight()) { do ball.bounceX(-1); }
                    } else {
                        let bx = b.getRight() + 6;
                        if (ball.movingLeft()) { do ball.bounceX(1); }
                    }
                }

                if (bounceTop) {
                    if ((ball.getBottom() - b.getTop()) < (b.getBottom() - by)) {
                        let by = b.getTop() - 6;
                        if (ball.movingDown()) { do ball.bounceY(-1); }
                    } else {
                        let by = b.getBottom() + 5;
                        if (ball.movingUp()) { do ball.bounceY(1); }
                    }
                }
                do ball.setPosition(bx, by);
            }
            let i = i + 1;
        }

        if (~hitBrick) {
            let lastHitBrick = null;
            // ---Paddle---
            let paddleLeft = paddle.getLeft();
            let paddleRight = paddle.getRight();
            let ballLeft = ball.getLeft();
            let ballRight = ball.getRight();

            if ((ballRight > paddleLeft) & (ballLeft < paddleRight) & (ball.getBottom() > paddle.getTop()) & (ball.getTop() < paddle.getBottom())) {
                if (~lastHitPaddle) {
                    let lastHitPaddle = true;
                    let bouncingDirection = 0;
                    if (ballRight < (paddleLeft + 10)) {
                        let bouncingDirection = -1;
                    } else {
                        if (ballLeft > (paddleRight - 10)) { let bouncingDirection = 1; }
                    }
                    do ball.setWall(4);
                    do ball.bounce(bouncingDirection);
                    do ball.setWall(0);
                }
            } else {
                let lastHitPaddle = false;

                if (currentWall > 0) {
                    let hasHit = false;

                    if (currentWall = 1) {          // left
                        if (ball.getLeft() = 0) { let hasHit = true; }
                    } else {
                        if (currentWall = 2) {      // right
                            if (ball.getLeft() = 505) { let hasHit = true; }  // 511-6
                        } else {
                            if (currentWall = 3) {  // top
                                if (ball.getTop() = 0) { let hasHit = true; }
                            } else {
                                if (currentWall = 4) { // bottom
                                    if (ball.getTop() = 232) { let hasHit = true; } // 238-6
                                }
                            }
                        }
                    }

                    if (hasHit & (~(currentWall = lastWall))) {
                        let lastWall = currentWall;

                        if (currentWall = 4) {
                            let health = health - 1;
                            do Output.moveCursor(22, 27);
                            do Output.printInt(health);
                            if (health = 0) {
                                let exit = true;
                            } else {
                                let launched = false;
                                let lastWall = 0;
                                let lastHitBrick = null;
                                let lastHitPaddle = false;
                                do stickBall();
                            }
                        } else {
                            // force a small separation + bounce
                            if (currentWall = 1) {
                                do ball.setPosition(2, ball.getTop());
                                do ball.bounceX(1);          // force right
                            } else {
                                if (currentWall = 2) {
                                    do ball.setPosition(503, ball.getTop());
                                    do ball.bounceX(-1);     // force left
                                } else { // top
                                    do ball.setPosition(ball.getLeft(), 2);
                                    do ball.bounceY(1);      // force down
                                }
                            }
                            let lastWall = 0;   // allow another bounce next frame if still needed
                        }
                    }
                }
            }
        }

        if (b.isAlive()) { do b.show(); }
        return;
    }

    method void removeBrick(Brick b) {
        var boolean destroyed;
        let destroyed = b.hit();
        let score = score + 1;
        do Output.moveCursor(22, 7);
        do Output.printInt(score);
        if (destroyed) {
            let bricksLeft = bricksLeft - 1;
            if (bricksLeft = 0) {
                let exit = true;
            }
        }
        return;
    }
}
