class Paddle {

    field int x, y;           // the paddle's screen location
    field int width, height;  // the paddle's width and height
    field int direction;      // 0 = stop, 1 = left, 2 = right

    /** Constructs a new paddle with the given location and width. */
    constructor Paddle new(int Ax, int Ay, int Awidth, int Aheight) {
        let x = Ax;
        let y = Ay;
        let width = Awidth;
        let height = Aheight;
        let direction = 0;
        do show();
        return this;
    }

    /** Deallocates the object's memory. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    /** Shows the paddle. */
    method void show() {
        do Screen.setColor(true);
        do draw();
        return;
    }

    /** Hides the paddle. */
    method void hide() {
        do Screen.setColor(false);
        do draw();
        return;
    }

    method void draw() {
        do Screen.drawRectangle(x, y, x + width, y + height);
        return;
    }

    /** Sets the paddle's direction (0=stop, 1=left, 2=right). */
    method void setDirection(int Adirection) {
        let direction = Adirection;
        return;
    }

    /** Returns the paddle's left edge. */
    method int getLeft() {
        return x;
    }

    method int getRight() {
        return x + width;
    }

    method int getTop() {
        return y;
    }

    method int getBottom() {
        return y + height;
    }

    /** Sets the paddle's width. */
    method void setWidth(int Awidth) {
        do hide();
        let width = Awidth;
        do show();
        return;
    }

    /** Moves the paddle one step in the paddle's direction. */
    method void move() {
        if (direction = 0) {
            return;
        }

        do hide();

	    if (direction = 1) {
            let x = x - 6;
            if (x < 0) { let x = 0; }
        }
        else {
            let x = x + 6;
            if ((x + width) > 511) { let x = 511 - width; }
        }

        do show();
        return;
    }
}